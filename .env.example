# ==============================================================================
# Gemini Bridge Configuration
# ==============================================================================
# Copy this file to .env and replace the values with your personal configuration.
#
#   cp .env.example .env
#

# Google Gemini API Key (Required for live chat & RAG generation)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# Gemini Model Selection
GEMINI_MODEL="gemini-3.6-flash"
GEMINI_EMBEDDING_MODEL="gemini-embedding-2"

# ChromaDB Vector Store Persistence Directory
CHROMA_PERSIST_DIR="./data/chroma"

# Text Chunking Settings
DEFAULT_CHUNK_SIZE=800
DEFAULT_CHUNK_OVERLAP=100

# CORS Allowed Origins (Comma-separated or JSON list)
CORS_ORIGINS=["*"]
